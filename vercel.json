{
  "functions": {
    "api/chat.go": {
      "includeFiles": "api/assets/**"
    }
  },
  "routes": [
    {
      "src": "/api/healthz",
      "dest": "/api/healthz/index.go"
    },
    {
      "src": "/api/files",
      "dest": "/api/files/index.go"
    },
    {
      "src": "/(.*)",
      "dest": "/api/chat.go"
    }
  ]
}
